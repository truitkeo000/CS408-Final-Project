[Unit]
Description=CS408 Django Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/CS408-Final-Project
EnvironmentFile=/home/ubuntu/CS408-Final-Project/.env
ExecStart=/home/ubuntu/CS408-Final-Project/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 config.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
